  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Accent-filled action; used sparingly.",
      "html": "<button class=\"ds-btn-primary\">Save key</button>",
      "css": ".ds-btn-primary{height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;background:var(--primary);color:var(--primary-foreground);font:500 14px \"Geist Variable\",sans-serif;cursor:pointer;transition:background-color 150ms ease}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent)}.ds-btn-primary:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Ghost Icon Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "The default in-app action: a monochrome icon that brightens on hover.",
      "html": "<button class=\"ds-btn-ghost\" aria-label=\"New tab\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;padding:4px;border:none;border-radius:8px;background:transparent;color:var(--muted-foreground);cursor:pointer;transition:background-color 150ms ease,color 150ms ease}.ds-btn-ghost:hover{background:var(--accent);color:var(--foreground)}.ds-btn-ghost:focus-visible{outline:2px solid var(--ring);outline-offset:1px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Compact field with an input-token stroke.",
      "html": "<input class=\"ds-input\" placeholder=\"Search repositories\" />",
      "css": ".ds-input{height:32px;width:240px;padding:4px 10px;border:1px solid var(--input);border-radius:10px;background:transparent;color:var(--foreground);font:400 14px \"Geist Variable\",sans-serif;outline:none;transition:border-color 150ms ease,box-shadow 150ms ease}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Pill",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Neutral metadata chip; the label variant carries a Linear-colored dot.",
      "html": "<span class=\"ds-pill\"><span class=\"ds-pill-dot\" style=\"background:#bb87fc\"></span>Frontend</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:4px;padding:2px 6px;border:1px solid var(--border);border-radius:8px;color:var(--muted-foreground);font:400 11px \"Geist Variable\",sans-serif}.ds-pill-dot{width:6px;height:6px;border-radius:9999px}"
    },
    {
      "name": "State Badge",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Review/CI state: state-token text over a 10% fill and 30% border.",
      "html": "<span class=\"ds-badge ds-badge-ok\">Approved</span> <span class=\"ds-badge ds-badge-warn\">Changes requested</span>",
      "css": ".ds-badge{display:inline-block;padding:2px 6px;border:1px solid;border-radius:8px;font:500 11px \"Geist Variable\",sans-serif}.ds-badge-ok{color:var(--success);background:color-mix(in oklch,var(--success) 10%,transparent);border-color:color-mix(in oklch,var(--success) 30%,transparent)}.ds-badge-warn{color:var(--warning);background:color-mix(in oklch,var(--warning) 10%,transparent);border-color:color-mix(in oklch,var(--warning) 30%,transparent)}"
    },
    {
      "name": "KPI Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Matte dashboard tile: card on background, hairline, no shadow.",
      "html": "<button class=\"ds-kpi\"><span class=\"ds-kpi-label\">Reviews</span><span class=\"ds-kpi-value\">4</span><span class=\"ds-kpi-meta\">2 waiting over 3 days</span></button>",
      "css": ".ds-kpi{display:flex;flex-direction:column;width:220px;padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--card);text-align:left;cursor:pointer;transition:border-color 150ms ease}.ds-kpi:hover{border-color:color-mix(in oklch,var(--foreground) 20%,transparent)}.ds-kpi:focus-visible{outline:none;box-shadow:0 0 0 2px color-mix(in oklch,var(--ring) 70%,transparent)}.ds-kpi-label{font:500 11px \"Geist Variable\",sans-serif;color:var(--muted-foreground)}.ds-kpi-value{margin-top:6px;font:600 28px/1 \"Geist Variable\",sans-serif;letter-spacing:-0.025em;font-variant-numeric:tabular-nums;color:var(--foreground)}.ds-kpi-meta{margin-top:12px;font:400 11px \"Geist Variable\",sans-serif;color:var(--muted-foreground)}"
    },
    {
      "name": "Dock",
      "kind": "nav",
      "refersTo": "dock",
      "description": "Floating bottom navigation; monochrome icons, accent only on the active view.",
      "html": "<nav class=\"ds-dock\"><button class=\"ds-dock-btn ds-active\" aria-label=\"Dashboard\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1\"/></svg></button><button class=\"ds-dock-btn\" aria-label=\"Calendar\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/></svg></button><button class=\"ds-dock-btn\" aria-label=\"Pull Requests\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"18\" cy=\"18\" r=\"3\"/><circle cx=\"6\" cy=\"6\" r=\"3\"/><path d=\"M13 6h3a2 2 0 0 1 2 2v7M6 9v12\"/></svg></button></nav>",
      "css": ".ds-dock{display:inline-flex;gap:4px;padding:6px;border:1px solid var(--border);border-radius:18px;background:var(--sidebar);box-shadow:0 25px 50px -12px var(--overlay-shadow)}.ds-dock-btn{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border:none;border-radius:14px;background:transparent;color:var(--muted-foreground);cursor:pointer;transition:background-color 150ms ease,color 150ms ease}.ds-dock-btn:hover{background:var(--accent);color:var(--foreground)}.ds-dock-btn:focus-visible{outline:2px solid var(--ring);outline-offset:1px}.ds-dock-btn.ds-active{background:color-mix(in oklch,var(--primary) 20%,transparent);color:var(--primary)}"
    },
    {
      "name": "Pane Tab",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "Tab strip item; the active tab sits on card, the focused pane gets a 2px accent bar.",
      "html": "<div class=\"ds-tabs\"><span class=\"ds-tab-bar\"></span><span class=\"ds-tab ds-tab-on\">Dashboard</span><span class=\"ds-tab\">Pull Requests</span></div>",
      "css": ".ds-tabs{display:flex;align-items:center;gap:4px;padding:6px 8px;border-bottom:1px solid var(--border);background:var(--background)}.ds-tab-bar{width:2px;height:16px;border-radius:9999px;background:var(--primary)}.ds-tab{padding:4px 10px;border-radius:8px;font:400 12px \"Geist Variable\",sans-serif;color:var(--muted-foreground);cursor:pointer;transition:background-color 150ms ease,color 150ms ease}.ds-tab:hover{background:color-mix(in oklch,var(--accent) 50%,transparent);color:var(--foreground)}.ds-tab-on{background:var(--card);color:var(--foreground)}"
    }
  ],
  "narrative": {
    "northStar": "The Matte Workbench",
    "overview": "Astryn is an all-day instrument for one engineer: dense but calm, read in short check-ins and long planning sessions. The surface is matte. Depth comes from small lightness steps between tinted neutrals (sidebar, background, card, popover), hairline borders, and nothing else at rest. Each theme carries exactly one low-chroma accent, used for selection, focus and the active place in the app.\n\nColor is a signal channel, not decoration. Hue appears only when it reports state (success, warning, destructive, info, merged) or when it is data from Linear (workflow-state and label colors). Navigation, tabs, dock and section icons are monochrome; a screen with nothing wrong is almost colorless.\n\nThe system ships as four interchangeable themes that share one token contract: Graphite (dark, steel-blue accent, the default), Charcoal (dark, warm neutrals, sage accent), Paper (light, warm neutrals, ink-blue accent) and Stone (light, cool neutrals, petrol accent). The owner picks a fixed theme or \"Match system\" with a chosen dark and light pair. Gradients, glows, glass and backdrop blur, and neon or purple-to-blue washes are confirmed rejections (PRODUCT.md brand commitments).",
    "keyCharacteristics": [
      "Four themes, one token contract; every component reads roles, never theme names.",
      "Tinted neutrals stepped by lightness for depth; hairline borders; no gradients.",
      "One low-chroma accent per theme, reserved for selection, focus and \"you are here\".",
      "Hue means state; Linear workflow and label colors pass through as data.",
      "Geist at small, dense sizes; mono for identifiers, clocks and diff counts."
    ],
    "rules": [
      {
        "name": "The Color Means State Rule",
        "body": "A hue may appear only to report state (the five state tokens), to mark selection/focus (primary), or to render Linear-provided workflow-state and label colors. Never color an icon, tab or section by category.",
        "section": "colors"
      },
      {
        "name": "The Priority Mapping Rule",
        "body": "Urgent = destructive, High = warning, Medium = info, Low and No priority = muted-foreground. The bar glyph fills in muted-foreground and turns destructive only for Urgent.",
        "section": "colors"
      },
      {
        "name": "The One Contract Rule",
        "body": "Every theme defines the identical token set. Components reference roles (`bg-card`, `text-success`), never literal colors; a new theme is a new `[data-theme]` block and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "Text and state tokens hold at least 4.5:1 against both background and card in every theme; primary-foreground holds at least 4.5:1 on primary. A new or edited token must pass before it ships.",
        "section": "colors"
      },
      {
        "name": "The 11px Floor Rule",
        "body": "No functional text renders below 11px. Weight and color, not shrinking, create the quiet tier.",
        "section": "typography"
      },
      {
        "name": "The Float-Only Shadow Rule",
        "body": "If it sits in the layout, it has no shadow. Only overlays and the dock lift.",
        "section": "elevation"
      },
      {
        "name": "The No Glass Rule",
        "body": "No backdrop blur, translucency-as-material, gradients or glows on any surface, in any theme.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reference role tokens (`background`, `card`, `primary`, `success`...) so every component works in all four themes unchanged.",
      "**Do** keep icons in navigation, tabs, dock and section headers monochrome (muted-foreground, foreground on hover, primary only when active).",
      "**Do** map priority as Urgent = destructive, High = warning, Medium = info, Low/None = muted-foreground.",
      "**Do** render Linear workflow-state and label colors exactly as the API supplies them.",
      "**Do** build state badges as state-token text over a 10% fill and 30% border of the same token.",
      "**Do** check any new or edited token for 4.5:1 text contrast on background and card, and 3:1 for input strokes and the focus ring, in every theme.",
      "**Do** take overlay shadows from `--overlay-shadow`, never a hard-coded black."
    ],
    "donts": [
      "**Don't** use gradients, glows, glass, backdrop blur, neon accents or purple-to-blue washes.",
      "**Don't** color an icon, tab or section to tell categories apart.",
      "**Don't** add a second accent hue to a theme; reach for a state token or for neutrals.",
      "**Don't** put shadows on resting cards, panels or rows.",
      "**Don't** set functional text below 11px.",
      "**Don't** hard-code a hex or a theme name inside a component."
