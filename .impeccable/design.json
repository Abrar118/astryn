    "themeSelection": "Fixed theme or \"auto\" (Match system) with a chosen dark and light theme. Applied as data-theme on <html> plus the .dark class and color-scheme for dark themes; persisted under localStorage key astryn.theme. Default { mode: graphite, dark: graphite, light: paper }. Source: src/lib/theme.ts, src/styles/themes.css.",
    "shadows": [
      {
        "name": "overlay-shadow-dark",
